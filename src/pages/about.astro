---
import Base from '../layouts/Base.astro';
import { AI_ANSWER } from '../lib/ai-answer';
import { CREDENTIALS, BIO, BIO_QUOTE, BIO_CLOSE, IN_PLACE } from '../lib/about';
import { EMAIL } from '../lib/site';
import { breadcrumbSchema, personSchema } from '../lib/schema';
import headshot from '../lib/brand-manifest.json';

const path = '/about';

const schema = [
  personSchema(),
  breadcrumbSchema([
    { name: 'Home', path: '/' },
    { name: 'About', path },
  ]),
];

const portrait = headshot['taylor-corbett'];
---

<Base
  title="About Taylor Corbett — AI Search & Content Strategy"
  description="Taylor Corbett runs Sonora, a search and content strategy practice for companies that need pipeline. Background in B2B software and local news."
  path={path}
  schema={schema}
>
  <section class="hero surface-ink">
    <div class="container hero-grid">
      <div>
        <p class="eyebrow-gold">About</p>
        <h1>Being better doesn&rsquo;t help if you&rsquo;re not in the answer.</h1>
        <p class="hero-lead">
          Sonora is senior content and search strategy for B2B software
          companies where inbound is the pipeline.
        </p>
      </div>

      {/*
        The demo plays itself: a buyer's question, then an answer naming three
        competitors and not you. Hidden from assistive tech, which gets the
        sentence below instead — it says the same thing without the theatre.
      */}
      <p class="visually-hidden">
        An AI answer to &ldquo;{AI_ANSWER.query}&rdquo; lists three competitors
        and names none of your company. {AI_ANSWER.counter}.
      </p>

      <div class="chat" aria-hidden="true">
        <p class="chat-head">
          <span class="chat-arch"></span>
          AI answer
        </p>
        <p class="chat-query">{AI_ANSWER.query}</p>
        <p class="chat-typing">
          <span class="dot"></span><span class="dot"></span><span class="dot"></span>
        </p>
        <p class="chat-lead">{AI_ANSWER.lead}</p>
        <div class="chat-results">
          {AI_ANSWER.results.map((result, i) => <span>{i + 1}. {result}</span>)}
        </div>
        <p class="chat-verdict">{AI_ANSWER.verdict}</p>
        <p class="chat-counter">
          <span class="counter-arch"></span>
          {AI_ANSWER.counter}
        </p>
      </div>
    </div>
  </section>

  <section class="section bio" aria-labelledby="bio-heading">
    <div class="container bio-grid">
      <div class="who" data-reveal>
        <img
          src="/images/taylor-corbett.webp"
          width={portrait.width}
          height={portrait.height}
          alt="Taylor Corbett"
          class="portrait"
          loading="lazy"
        />
        <p class="who-name">Taylor Corbett</p>
        <p class="who-role" id="bio-heading">Founder and Principal Strategist</p>

        <ul class="credentials">
          {
            CREDENTIALS.map((item) => (
              <li>
                <span class="bullet" aria-hidden="true"></span>
                <span>{item}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="story" data-reveal>
        {BIO.map((paragraph) => <p>{paragraph}</p>)}
        <p class="bio-quote">{BIO_QUOTE}</p>
        <p>{BIO_CLOSE}</p>
      </div>
    </div>
  </section>

  <section id="enquiry" class="section touch surface-ink" aria-labelledby="touch-heading">
    <div class="container touch-grid">
      <div data-reveal>
        <p class="eyebrow-gold">Get in touch</p>
        <h2 id="touch-heading">See where you stand in AI and search.</h2>
        <p class="touch-lead">
          Thirty minutes. Tell us what&rsquo;s not working and you&rsquo;ll get a
          straight answer about whether we can fix it &mdash; including if the
          answer is no.
        </p>
        <p class="touch-links">
          <a href={`mailto:${EMAIL}`}>{EMAIL}</a>
          <a href="/book">Or book a call directly &rarr;</a>
        </p>
      </div>

      <div class="form-card" data-reveal>
        <form
          name="enquiry"
          method="POST"
          action="/thanks"
          data-netlify="true"
          netlify-honeypot="fax-number"
          class="enquiry"
        >
          <input type="hidden" name="form-name" value="enquiry" />
          <p class="hp">
            <label for="e-fax">Leave this field empty</label>
            <input id="e-fax" name="fax-number" tabindex="-1" autocomplete="off" />
          </p>

          <p class="field">
            <label for="e-name">Name</label>
            <input id="e-name" name="name" type="text" autocomplete="name" required />
          </p>
          <p class="field">
            <label for="e-email">Email</label>
            <input id="e-email" name="email" type="email" autocomplete="email" required />
          </p>
          <p class="field wide">
            <label for="e-company">Company URL</label>
            <input
              id="e-company"
              name="company"
              type="url"
              placeholder="company.com"
              autocomplete="url"
            />
          </p>
          <p class="field wide">
            <label for="e-offer">What are you selling, and to who?</label>
            <span class="hint" id="e-offer-hint">One line is fine.</span>
            <input id="e-offer" name="offer" type="text" aria-describedby="e-offer-hint" required />
          </p>
          <p class="field wide">
            <label for="e-trigger">What made you reach out now?</label>
            <span class="hint" id="e-trigger-hint">
              A ranking that slipped, a competitor showing up in AI answers, a
              launch coming, a hire you&rsquo;re deciding against &mdash;
              whatever it was.
            </span>
            <textarea
              id="e-trigger"
              name="trigger"
              rows={3}
              aria-describedby="e-trigger-hint"
              required></textarea>
          </p>
          <p class="field wide">
            <label for="e-inplace">What&rsquo;s in place now?</label>
            <select id="e-inplace" name="inplace">
              {IN_PLACE.map((option) => <option>{option}</option>)}
            </select>
          </p>

          <p class="submit wide">
            <button type="submit" class="send">Send</button>
            <span class="reply-note">Replies within a business day.</span>
          </p>
        </form>
      </div>
    </div>
  </section>
</Base>

<style>
  /* ---- Hero ---- */
  .hero {
    padding-block: clamp(64px, 9vw, 112px) clamp(56px, 7vw, 96px);
  }

  .hero-grid {
    display: grid;
    gap: clamp(40px, 5vw, 72px);
  }

  @media (min-width: 1040px) {
    .hero-grid {
      grid-template-columns: minmax(0, 620px) 320px;
      justify-content: start;
      align-items: end;
    }
  }

  .hero h1 {
    margin-top: 20px;
    font-size: clamp(2.5rem, 5.8vw, 4rem);
    line-height: 1.03;
    letter-spacing: -0.04em;
    max-width: 17ch;
    text-wrap: balance;
  }

  .hero-lead {
    margin-top: 26px;
    font-size: clamp(1.1875rem, 2vw, 1.375rem);
    line-height: 1.5;
    max-width: 56ch;
    color: var(--paper);
    opacity: 0.82;
  }

  /* ---- The AI-answer demo ---- */
  .chat {
    width: 100%;
    max-width: 320px;
    height: 390px;
    background: #12104A;
    border: 1px solid var(--rule-on-ink);
    border-radius: 2px;
    padding: 22px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .chat-head {
    display: flex;
    align-items: center;
    gap: 9px;
    padding-bottom: 14px;
    border-bottom: 1px solid var(--rule-on-ink);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted-on-ink);
  }

  .chat-arch {
    flex: none;
    width: 11px;
    height: 14px;
    background: var(--accent);
    border-radius: 6px 6px 1px 1px;
  }

  .chat-query {
    align-self: flex-end;
    max-width: 82%;
    background: var(--paper);
    color: var(--ink);
    border-radius: 10px 10px 2px 10px;
    padding: 11px 14px;
    font-size: 14px;
    line-height: 1.45;
  }

  /* The typing indicator only means something mid-sequence. With no animation
     the card is a finished answer, and three dots below it read as stuck. */
  .chat-typing {
    display: none;
    gap: 6px;
    padding: 4px 2px;
  }

  .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--muted-on-ink);
  }

  .chat-lead {
    font-size: 14px;
    line-height: 1.55;
    color: var(--paper);
  }

  .chat-results {
    display: flex;
    flex-direction: column;
    gap: 7px;
    font-size: 14px;
    line-height: 1.5;
    color: var(--paper);
  }

  .chat-verdict {
    border-left: 2px solid var(--accent);
    padding-left: 11px;
    font-size: 14px;
    line-height: 1.5;
    color: var(--accent);
  }

  .chat-counter {
    margin-top: auto;
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 12px;
    color: var(--muted-on-ink);
  }

  .counter-arch {
    flex: none;
    width: 9px;
    height: 11px;
    background: var(--accent);
    border-radius: 5px 5px 1px 1px;
  }

  /* The card reads as a finished answer with no animation at all, which is
     what reduced motion and a CSS-animation-less renderer both get. The
     animation only holds each line back until its turn. */
  @media (prefers-reduced-motion: no-preference) {
    @keyframes chat-q {
      0% { opacity: 0; transform: translateY(8px); }
      4%, 93% { opacity: 1; transform: none; }
      98%, 100% { opacity: 0; transform: translateY(-4px); }
    }
    @keyframes chat-typing {
      0%, 9% { opacity: 0; }
      13%, 27% { opacity: 1; }
      31%, 100% { opacity: 0; }
    }
    @keyframes chat-a1 {
      0%, 29% { opacity: 0; transform: translateY(8px); }
      34%, 93% { opacity: 1; transform: none; }
      98%, 100% { opacity: 0; }
    }
    @keyframes chat-a2 {
      0%, 39% { opacity: 0; transform: translateY(8px); }
      44%, 93% { opacity: 1; transform: none; }
      98%, 100% { opacity: 0; }
    }
    @keyframes chat-a3 {
      0%, 51% { opacity: 0; transform: translateY(8px); }
      56%, 93% { opacity: 1; transform: none; }
      98%, 100% { opacity: 0; }
    }
    @keyframes chat-a4 {
      0%, 62% { opacity: 0; transform: translateY(8px); }
      67%, 93% { opacity: 1; transform: none; }
      98%, 100% { opacity: 0; }
    }
    @keyframes dot-bounce {
      0%, 100% { transform: translateY(0); opacity: 0.5; }
      50% { transform: translateY(-4px); opacity: 1; }
    }

    .chat-typing { display: flex; }

    .chat-query { animation: chat-q 9s ease-out infinite; }
    .chat-typing { animation: chat-typing 9s ease-out infinite; }
    .chat-lead { animation: chat-a1 9s ease-out infinite; }
    .chat-results { animation: chat-a2 9s ease-out infinite; }
    .chat-verdict { animation: chat-a3 9s ease-out infinite; }
    .chat-counter { animation: chat-a4 9s ease-out infinite; }
    .dot { animation: dot-bounce 1.1s ease-in-out infinite; }
    .dot:nth-child(2) { animation-delay: 0.15s; }
    .dot:nth-child(3) { animation-delay: 0.3s; }
  }

  /* ---- Bio ---- */
  .bio-grid {
    display: grid;
    gap: clamp(40px, 5vw, 72px);
  }

  @media (min-width: 900px) {
    .bio-grid {
      grid-template-columns: minmax(260px, 340px) minmax(0, 1fr);
      align-items: start;
    }
  }

  /* Arch-topped, like the brand mark. */
  .portrait {
    display: block;
    width: 280px;
    max-width: 100%;
    height: 340px;
    object-fit: cover;
    object-position: center 20%;
    border-radius: 140px 140px 2px 2px;
    margin-bottom: 28px;
  }

  .who-name {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .who-role {
    margin-top: 12px;
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: clamp(1.375rem, 2.2vw, 1.625rem);
    letter-spacing: -0.01em;
    color: var(--ink);
  }

  .credentials {
    margin: 26px 0 0;
    padding: 0;
    list-style: none;
  }

  .credentials li {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    padding-block: 16px;
    border-top: 1px solid var(--rule);
    font-size: 17px;
  }

  .bullet {
    flex: none;
    width: 12px;
    height: 15px;
    margin-top: 6px;
    background: var(--accent);
    border-radius: 6px 6px 1px 1px;
  }

  .story {
    max-width: 68ch;
  }

  .story > p {
    font-size: clamp(1.0625rem, 1.5vw, 1.25rem);
  }

  .story > p + p {
    margin-top: 24px;
  }

  .story > .bio-quote {
    margin-top: 28px;
    padding-left: 18px;
    border-left: 3px solid var(--accent);
    font-family: var(--font-heading);
    font-weight: 500;
    font-size: clamp(1.375rem, 2.6vw, 1.75rem);
    line-height: 1.35;
    color: var(--ink);
  }

  .story > .bio-quote + p {
    margin-top: 28px;
  }

  /* ---- Get in touch ---- */
  .touch-grid {
    display: grid;
    gap: clamp(40px, 5vw, 80px);
  }

  @media (min-width: 900px) {
    .touch-grid {
      grid-template-columns: minmax(280px, 420px) minmax(0, 1fr);
      align-items: start;
    }
  }

  .touch h2 {
    margin-top: 18px;
    font-size: clamp(1.875rem, 3.6vw, 2.75rem);
    line-height: 1.06;
    letter-spacing: -0.03em;
    max-width: 18ch;
  }

  .touch-lead {
    margin-top: 18px;
    font-size: clamp(1.0625rem, 1.5vw, 1.25rem);
    max-width: 44ch;
    color: var(--paper);
    opacity: 0.82;
  }

  .touch-links {
    margin-top: 30px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    align-items: flex-start;
    font-size: 17px;
  }

  .touch-links a {
    color: var(--paper);
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
  }

  .touch-links a:hover {
    text-decoration-thickness: 3px;
  }

  /* ---- The enquiry form ---- */
  .form-card {
    background: var(--paper);
    border-radius: 2px;
    padding: clamp(28px, 4vw, 40px) clamp(24px, 4vw, 42px) clamp(32px, 4.5vw, 44px);
  }

  .enquiry {
    display: grid;
    gap: 20px;
  }

  @media (min-width: 560px) {
    .enquiry {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }
  }

  .wide {
    grid-column: 1 / -1;
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .field label {
    font-size: 15px;
    font-weight: 600;
    color: var(--ink);
  }

  .field .hint {
    margin-top: -4px;
    font-size: 15px;
    color: var(--muted);
  }

  .field input,
  .field textarea,
  .field select {
    font-family: inherit;
    font-size: 17px;
    padding: 14px 16px;
    border: 1px solid var(--rule);
    border-radius: 2px;
    background: var(--paper-raised);
    color: var(--ink);
  }

  .field textarea {
    resize: vertical;
    min-height: 110px;
  }

  .field input:focus-visible,
  .field textarea:focus-visible,
  .field select:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 1px;
  }

  .submit {
    display: flex;
    align-items: center;
    gap: 24px;
    flex-wrap: wrap;
    margin-top: 6px;
  }

  .send {
    font-family: inherit;
    font-weight: 600;
    font-size: 17px;
    padding: 18px 34px;
    border-radius: 2px;
    background: var(--ink);
    color: var(--paper);
    border: 1px solid var(--ink);
    cursor: pointer;
    transition: transform 140ms ease-out, background-color 140ms ease-out,
      color 140ms ease-out;
  }

  .send:hover {
    transform: translateY(-2px);
    background: var(--accent);
    color: var(--ink);
  }

  .reply-note {
    font-size: 16px;
    color: var(--muted);
  }

  /* The honeypot Netlify watches. Off-screen rather than display:none, which
     some bots detect. */
  .hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
</style>
