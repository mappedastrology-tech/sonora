---
import Base from '../layouts/Base.astro';
import CTABlock from '../components/CTABlock.astro';
import { breadcrumbSchema, personSchema } from '../lib/schema';

const path = '/about';

const schema = [
  personSchema(),
  breadcrumbSchema([
    { name: 'Home', path: '/' },
    { name: 'About', path },
  ]),
];
---

<Base
  title="About Taylor Corbett — AI Search & Content Strategy"
  description="Taylor Corbett runs Sonora, a search and content strategy practice for companies that need pipeline. Background in B2B software content and local television news."
  path={path}
  schema={schema}
>
  <article class="section page-hero">
    <div class="container">
      <img
        src="/images/taylor-corbett.webp"
        alt="Taylor Corbett, founder of Sonora"
        width="520"
        height="520"
        fetchpriority="high"
        decoding="async"
        class="headshot"
      />

      <div class="prose about-body">
        <h1>About</h1>

        <p class="lead">
          My name is Taylor. I started Sonora after watching a lot of good
          startups hit the same wall &mdash; building, hiring, raising, and
          almost nothing coming in the door.
        </p>

        <p>
          It was never a product problem. It was that nobody owned inbound.
          Marketing was somebody&rsquo;s third priority, so it got pushed until
          after the next release, and then the one after that. Meanwhile a
          competitor with a worse product was showing up in every search and
          every AI answer and taking the deals.
        </p>

        <p>
          I know that problem from the inside. I spent the last several years
          leading content and search at a B2B software company with no outbound
          motion at all &mdash; inbound was the pipeline, and my team built it.
          Before that, about a decade in local news, where the whole job was
          knowing what people were going to look for and getting there before
          they looked.
        </p>

        <p>
          I work alone by design. You get senior judgment on every decision
          instead of a partner in the pitch and an associate on the work.
        </p>
      </div>
    </div>
  </article>

  <CTABlock />
</Base>

<style>
  .page-hero {
    padding-block: clamp(48px, 6vw, 80px) clamp(56px, 7vw, 96px);
  }

  .headshot {
    width: min(520px, 100%);
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: 260px 260px 2px 2px;
    margin-bottom: clamp(40px, 5vw, 64px);
  }

  .about-body .lead {
    margin-top: 32px;
  }
</style>
