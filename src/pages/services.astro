---
import Base from '../layouts/Base.astro';
import CTABlock from '../components/CTABlock.astro';
import { SERVICE_DETAIL } from '../lib/services-detail';
import { breadcrumbSchema, serviceSchema } from '../lib/schema';

const path = '/services';

const schema = [
  breadcrumbSchema([
    { name: 'Home', path: '/' },
    { name: 'Services', path },
  ]),
  ...SERVICE_DETAIL.map((service) =>
    serviceSchema({
      slug: service.slug,
      name: service.name,
      description: service.body,
    })
  ),
];
---

<Base
  title="AI Visibility Audits & Fractional Content Leadership — Sonora"
  description="AI visibility audits, strategy sprints, fractional head of content, and quarterly AI search monitoring for companies that need pipeline."
  path={path}
  schema={schema}
>
  <section class="section page-hero">
    <div class="container">
      <div class="prose">
        <h1>Services</h1>
        <p class="lead">
          I set strategy and direct the work. I don&rsquo;t write, design, or
          build &mdash; your team or your contractors do that, and I make sure
          what they produce is worth having made.
        </p>
        <p>Most engagements start with the audit.</p>
      </div>
    </div>
  </section>

  {
    SERVICE_DETAIL.map((service, index) => (
      <section
        id={service.slug}
        class:list={['section service', index % 2 === 0 ? 'surface-ink' : '']}
        aria-labelledby={`${service.slug}-heading`}
      >
        <div class="container">
          <div class="service-inner" data-reveal>
            <div class="prose">
              <p class="eyebrow">{service.cadence}</p>
              <h2 id={`${service.slug}-heading`}>{service.name}</h2>
              <p>{service.body}</p>
            </div>

            <div class="detail">
              <ul class="arch-list">
                {service.includes.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>

              <p class="start-here">
                <strong>Start here if</strong> {service.startHereIf}
              </p>

              <p class="book">
                <a href="/book" class="btn">Book a call</a>
              </p>
            </div>
          </div>
        </div>
      </section>
    ))
  }

  <CTABlock />
</Base>

<style>
  .page-hero {
    padding-block: clamp(56px, 7vw, 96px) clamp(48px, 6vw, 72px);
  }

  .page-hero .lead {
    margin-top: 28px;
  }

  .service-inner {
    display: grid;
    gap: clamp(32px, 4vw, 48px);
  }

  @media (min-width: 900px) {
    .service-inner {
      grid-template-columns: 1fr 1fr;
      gap: 72px;
      align-items: start;
    }
  }

  .eyebrow {
    margin-bottom: 16px;
  }

  .service h2 {
    margin-bottom: 20px;
  }

  .detail li {
    color: var(--surface-text);
  }

  .start-here {
    margin-top: 32px;
    max-width: 46ch;
    color: var(--surface-text);
  }

  .start-here strong {
    color: var(--surface-heading);
  }

  .book {
    margin-top: 36px;
  }
</style>
