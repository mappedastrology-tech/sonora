<script>
  /* The two-path toggle. Progressive: the page renders with "engine" active,
     which is a complete state on its own, and this only swaps which card is
     highlighted. */
  const group = document.querySelector<HTMLElement>('[data-paths]');

  if (group) {
    const cards = Array.from(group.querySelectorAll<HTMLButtonElement>('[data-path]'));

    cards.forEach((card) => {
      card.addEventListener('click', () => {
        cards.forEach((other) => {
          const active = other === card;
          other.classList.toggle('active', active);
          other.setAttribute('aria-pressed', String(active));
        });
      });
    });
  }
</script>
