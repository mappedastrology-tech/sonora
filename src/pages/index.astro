---
import Base from '../layouts/Base.astro';
import MethodStages from '../components/MethodStages.astro';
import ServiceCard from '../components/ServiceCard.astro';
import CTABlock from '../components/CTABlock.astro';
import SectionDivider from '../components/SectionDivider.astro';
import ZeroClickChart from '../components/charts/ZeroClickChart.astro';
import BuyerStats from '../components/charts/BuyerStats.astro';
import CoverageChart from '../components/charts/CoverageChart.astro';
import { SERVICES } from '../lib/site';
import { breadcrumbSchema } from '../lib/schema';

const schema = [breadcrumbSchema([{ name: 'Home', path: '/' }])];
---

<Base
  title="AI Search & Content Strategy for Pipeline — Sonora"
  description="Search and content strategy for companies that need leads. AI search visibility (AEO), SEO, and content direction that turns search into pipeline."
  path="/"
  schema={schema}
>
  <!-- 1 — Hero -->
  <section class="section hero">
    <div class="container">
      <img
        src="/brand/sonora-full.webp"
        alt="Sonora"
        width="280"
        height="194"
        fetchpriority="high"
        decoding="async"
        class="mark"
      />
      <div class="prose">
        <h1>Your competitors aren&rsquo;t better. They&rsquo;re just easier to find.</h1>
        <p class="lead">
          Sonora is search and content strategy for companies that need
          pipeline. I find where your buyers are actually looking, get you in
          front of them, and build a channel that keeps working after the
          campaign ends.
        </p>
        <div class="btn-row">
          <a href="/book" class="btn">Book a call</a>
          <a href="/method" class="btn-secondary">See the method</a>
        </div>
      </div>
    </div>
  </section>

  <!-- 2 — Why the old playbook stopped working -->
  <section class="section surface-ink" aria-labelledby="ranking">
    <div class="container">
      <div class="prose" data-reveal>
        <h2 id="ranking">Ranking first isn&rsquo;t the same as getting found.</h2>
        <p>
          In early 2026, 68% of US Google searches ended without a single click.
          Only about 276 of every 1,000 now reach the open web at all.
        </p>
        <p>You can win the ranking and receive nothing.</p>
      </div>
      <div class="chart-slot" data-reveal>
        <ZeroClickChart />
      </div>
    </div>
  </section>

  <!-- 3 — Where the decision happens -->
  <section class="section" aria-labelledby="decision">
    <div class="container">
      <div class="prose" data-reveal>
        <h2 id="decision">They decide before they contact you.</h2>
        <p>
          B2B buyers weigh an average of seven information sources before
          choosing. Two thirds want to get through it without talking to anyone.
        </p>
        <p>
          Most of those sources aren&rsquo;t yours. If you&rsquo;re absent from
          them you&rsquo;re not in the running, and you&rsquo;ll never see the
          deal you didn&rsquo;t get.
        </p>
      </div>
      <div class="chart-slot" data-reveal>
        <BuyerStats />
      </div>
    </div>
  </section>

  <!-- 4 — The real problem -->
  <section class="section surface-ink" aria-labelledby="real-problem">
    <div class="container">
      <div class="prose" data-reveal>
        <h2 id="real-problem">Marketing first. Sales second.</h2>
        <p>
          Most early-stage companies don&rsquo;t have a product problem. They
          have a nobody-knows-we-exist problem, and the usual response is to hire
          another salesperson.
        </p>
        <p>
          But a rep with no leads spends the week prospecting cold instead of
          closing. That&rsquo;s the slowest and most expensive way to create
          demand, and it&rsquo;s why so many first sales hires quietly
          don&rsquo;t work out.
        </p>
        <p>
          Build the engine that brings people to you. Then hire salespeople to
          work the flow, not to create it.
        </p>
        <p>
          Being good isn&rsquo;t a distribution strategy. Right now a competitor
          with a worse product is showing up in every search, every AI answer,
          and every comparison page, and taking deals you should be winning.
        </p>
      </div>
    </div>
  </section>

  <!-- 5 — The Method -->
  <section class="section" aria-labelledby="method-heading">
    <div class="container">
      <div class="prose section-intro" data-reveal>
        <h2 id="method-heading">The Sonora Method</h2>
        <p class="lead">
          Four stages for turning search into a source of leads. Not traffic
          &mdash; leads.
        </p>
      </div>
      <MethodStages />
      <p class="section-link" data-reveal>
        <a href="/method" class="textlink">The full method &rarr;</a>
      </p>
    </div>
  </section>

  <SectionDivider />

  <!-- 6 — Services -->
  <section class="section" aria-labelledby="services-heading">
    <div class="container">
      <div class="prose section-intro" data-reveal>
        <h2 id="services-heading">How we work together</h2>
      </div>
      <ul class="service-grid" data-reveal>
        {
          SERVICES.map((service) => (
            <ServiceCard
              name={service.name}
              oneLiner={service.oneLiner}
              href={`/services#${service.slug}`}
            />
          ))
        }
      </ul>
      <p class="section-link" data-reveal>
        <a href="/services" class="textlink">What&rsquo;s included &rarr;</a>
      </p>
    </div>
  </section>

  <!-- 7 — Your category, already -->
  <section class="section surface-ink" aria-labelledby="already">
    <div class="container">
      <div class="prose" data-reveal>
        <h2 id="already">This is already happening in your market.</h2>
      </div>
      <div class="chart-slot" data-reveal>
        <CoverageChart />
      </div>
      <div class="prose after-chart" data-reveal>
        <p>
          Four out of five searches in your category already return an AI answer.
          Waiting isn&rsquo;t a strategy.
        </p>
      </div>
    </div>
  </section>

  <!-- 8 — About preview -->
  <section class="section about-preview" aria-labelledby="about-heading">
    <div class="container about-grid">
      <img
        src="/images/taylor-corbett.webp"
        alt="Taylor Corbett, founder of Sonora"
        width="400"
        height="400"
        loading="lazy"
        decoding="async"
        class="headshot"
      />
      <div class="prose" data-reveal>
        <h2 id="about-heading">Who you&rsquo;d be working with</h2>
        <p>
          My name is Taylor. I started Sonora after watching a lot of good
          startups hit the same wall &mdash; building, hiring, raising, and
          almost nothing coming in the door. It was never a product problem.
          Nobody owned inbound.
        </p>
        <p><a href="/about" class="textlink">About &rarr;</a></p>
      </div>
    </div>
  </section>

  <!-- 9 — CTA block -->
  <CTABlock />
</Base>

<style>
  .hero {
    padding-block: clamp(48px, 6vw, 88px) clamp(56px, 7vw, 96px);
  }

  .mark {
    width: min(280px, 60vw);
    height: auto;
    margin-bottom: clamp(32px, 4vw, 48px);
  }

  .hero h1 {
    max-width: 18ch;
  }

  .hero .lead {
    margin-top: 28px;
  }

  .section-intro {
    margin-bottom: clamp(40px, 5vw, 64px);
  }

  .section-intro .lead {
    margin-top: 20px;
  }

  .section-link {
    margin-top: clamp(40px, 4vw, 56px);
    font-weight: 500;
  }

  .chart-slot {
    margin-top: clamp(40px, 5vw, 64px);
  }

  .after-chart {
    margin-top: clamp(40px, 5vw, 56px);
  }

  .service-grid {
    display: grid;
    gap: 24px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  @media (min-width: 640px) {
    .service-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1000px) {
    .service-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .about-grid {
    display: grid;
    gap: clamp(32px, 5vw, 64px);
    align-items: start;
  }

  @media (min-width: 900px) {
    .about-grid {
      grid-template-columns: 400px 1fr;
      gap: 72px;
    }
  }

  /* Square with rounded top corners: the arch, applied to the headshot. */
  .headshot {
    width: min(400px, 100%);
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: 200px 200px 2px 2px;
  }
</style>
