---
import Base from '../layouts/Base.astro';
import { BOOKING_URL, BOOKING_EMBED_URL, EMAIL } from '../lib/site';
import { breadcrumbSchema } from '../lib/schema';

const path = '/book';

const schema = [
  breadcrumbSchema([
    { name: 'Home', path: '/' },
    { name: 'Book a call', path },
  ]),
];
---

<Base
  title="Book a call — Sonora"
  description="Thirty minutes. Tell me what you are trying to fix and I will tell you whether I am the right person for it."
  path={path}
  schema={schema}
>
  <section class="section book">
    <div class="container">
      <div class="prose">
        <h1>Book a call.</h1>
        <p class="lead">
          Thirty minutes. Tell me what you&rsquo;re trying to fix and I&rsquo;ll
          tell you whether I&rsquo;m the right person for it.
        </p>
      </div>

      <div class="embed-wrap">
        <iframe
          src={BOOKING_EMBED_URL}
          title="Book a thirty-minute call with Taylor Corbett"
          loading="lazy"
          class="booking-frame"
        ></iframe>

        <!-- Always present, never hidden. Some browsers and privacy extensions
             block third-party calendar frames, and the booking still has to
             work when they do. -->
        <p class="fallback">
          Calendar not loading?{' '}
          <a href={BOOKING_URL} class="textlink" rel="noopener">Open the booking page directly</a>, or
          email{' '}
          <a href={`mailto:${EMAIL}`} class="textlink">{EMAIL}</a>.
        </p>
      </div>
    </div>
  </section>
</Base>

<style>
  .book {
    padding-block: clamp(56px, 7vw, 96px);
  }

  .book .lead {
    margin-top: 28px;
  }

  .embed-wrap {
    margin-top: clamp(40px, 5vw, 64px);
  }

  .booking-frame {
    display: block;
    width: 100%;
    max-width: 820px;
    height: 680px;
    border: 1px solid var(--rule);
    border-radius: 2px;
    background: var(--paper);
  }

  @media (max-width: 640px) {
    .booking-frame {
      height: 760px;
    }
  }

  .fallback {
    margin-top: 24px;
    font-size: 1rem;
    color: var(--muted);
  }
</style>
