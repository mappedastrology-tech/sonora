---
import Base from '../layouts/Base.astro';
import CTABlock from '../components/CTABlock.astro';
import { STAGE_DETAIL } from '../lib/method-page';
import { FAQS } from '../lib/faq';
import { breadcrumbSchema, faqSchema } from '../lib/schema';

const path = '/method';

const schema = [
  breadcrumbSchema([
    { name: 'Home', path: '/' },
    { name: 'Method', path },
  ]),
  faqSchema(
    FAQS.map((faq) => ({ question: faq.question, answer: faq.answer })),
    path
  ),
];
---

<Base
  title="The Sonora Method — Positioning, Search and Content Strategy"
  description="Four stages for turning search into pipeline: Listen, Locate, Saturate, Sustain. Positioning, answer engine optimization and measurement for B2B companies."
  path={path}
  schema={schema}
>
  <section class="hero surface-ink">
    <div class="container hero-grid">
      <div>
        <h1>The Sonora Method</h1>
        <p class="hero-lead">
          Four stages for turning search into a source of leads.
        </p>
      </div>

      {/*
        The four stages as a vertical stack: an icon, a number and a name each,
        against a faint grid with circuit traces routed behind them.

        The icon carries the state. A stage still to come is a pale arch inside
        sonar rings; the current stage is a solid gold arch; a stage already
        passed is just the arch outline. The rail runs gold down to the current
        stage and grey below it.

        The rail and the traces sit outside the list rather than in it, so the
        steps number 1-4 for both the script and a screen reader.
      */}
      <div class="stack" data-stack>
        <span class="grid" aria-hidden="true"></span>

        <svg
          class="traces"
          viewBox="0 0 320 420"
          preserveAspectRatio="none"
          aria-hidden="true"
          focusable="false"
        >
          <g class="trace">
            <polyline points="232,0 232,58 290,58" />
            <circle cx="290" cy="58" r="3" />
            <polyline points="290,120 290,168 320,168" />
            <circle cx="290" cy="120" r="3" />
            <polyline points="266,150 266,214 300,214 300,290" />
            <circle cx="266" cy="150" r="3" />
          </g>
          <g class="trace trace-lit">
            <polyline points="0,250 44,250 44,206 84,206" />
            <circle cx="44" cy="206" r="3" />
            <circle cx="84" cy="206" r="3" />
          </g>
        </svg>

        <span class="rail" aria-hidden="true"><span class="rail-lit"></span></span>

        <ol class="steps">
          {
            STAGE_DETAIL.map((stage) => (
              <li class="step">
                <span class="icon" aria-hidden="true">
                  <span class="ring ring-outer"></span>
                  <span class="ring ring-inner"></span>
                  <span class="arch-fill"></span>
                  <span class="arch-line"></span>
                </span>
                <span class="step-number">{stage.number}</span>
                <span class="step-name">{stage.name}</span>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  {
    STAGE_DETAIL.map((stage, index) => (
      <section
        class:list={['section stage', index % 2 === 1 ? 'surface-ink' : '']}
        aria-labelledby={`stage-${stage.number}-heading`}
        id={`stage-${stage.number}`}
      >
        <div class="container">
          <div class="stage-inner">
            <div class="stage-mark" data-reveal>
              <p class="stage-numeral">{stage.number}</p>
              <h2 id={`stage-${stage.number}-heading`}>{stage.name}</h2>
              <p class="stage-summary">{stage.summary}</p>
            </div>

            <div class="stage-body prose" data-reveal>
              {stage.paragraphs.map((paragraph) => (
                <p>{paragraph}</p>
              ))}

              {'aside' in stage && stage.aside && (
                <aside class="aside">
                  <h3>{stage.aside.heading}</h3>
                  {stage.aside.paragraphs.map((paragraph) => (
                    <p>{paragraph}</p>
                  ))}
                </aside>
              )}

              {'pullQuote' in stage && stage.pullQuote && (
                <p class="pull-quote">{stage.pullQuote}</p>
              )}
            </div>
          </div>
        </div>
      </section>
    ))
  }

  <section class="section faq" aria-labelledby="faq-heading">
    <div class="container">
      <div class="prose" data-reveal>
        <h2 id="faq-heading">Common questions</h2>
        <div class="faq-list">
          {
            FAQS.map((faq) => (
              <div class="faq-item">
                <h3>{faq.question}</h3>
                <p>{faq.answer}</p>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <CTABlock />
</Base>

<script>
  /*
   * Walk the four stages: one active at a time, everything above it done and
   * everything below it still to come.
   *
   * Driven from script rather than keyframes because each stage has three
   * visual states and the rail's length depends on which one is current —
   * expressing that in CSS animation means one keyframe block per stage per
   * layer, all of which then have to stay in step with each other by hand.
   *
   * With no script, or under prefers-reduced-motion, no state attribute is ever
   * set and the CSS resting state stands: four gold arches, four names in
   * paper. Legible, and never caught mid-transition.
   */
  const stack = document.querySelector<HTMLElement>('[data-stack]');
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (stack && !reduced) {
    const steps = Array.from(stack.querySelectorAll<HTMLElement>('.step'));
    const lit = stack.querySelector<HTMLElement>('.rail-lit');

    if (steps.length && lit) {
      let current = 0;

      const paint = () => {
        steps.forEach((step, i) => {
          step.dataset.state = i === current ? 'active' : i < current ? 'done' : 'upcoming';
        });
        // The lit rail ends at the bottom of the current stage.
        lit.style.height = `${((current + 1) / steps.length) * 100}%`;
      };

      paint();
      window.setInterval(() => {
        current = (current + 1) % steps.length;
        paint();
      }, 2000);
    }
  }
</script>

<style>
  .hero {
    padding-block: clamp(64px, 9vw, 112px) clamp(56px, 7vw, 96px);
  }

  .hero-grid {
    display: grid;
    gap: clamp(40px, 6vw, 72px);
    align-items: center;
  }

  @media (min-width: 900px) {
    .hero-grid {
      grid-template-columns: 1fr minmax(280px, 360px);
    }
  }

  .hero h1 {
    font-size: clamp(2.75rem, 6.4vw, 4.5rem);
    line-height: 1.02;
    letter-spacing: -0.04em;
    text-wrap: balance;
  }

  .hero-lead {
    margin-top: 24px;
    font-size: clamp(1.1875rem, 2vw, 1.375rem);
    line-height: 1.5;
    max-width: 34ch;
    color: var(--paper);
    opacity: 0.82;
  }

  /* ---- The stage stack ----
     A rail down the left, the four stages beside it, and a faint grid with
     circuit traces behind the lot. The rows are forced to equal height so a
     quarter of the rail is exactly one row, whatever the rows measure. */
  .stack {
    position: relative;
    display: grid;
    grid-template-columns: 2px 1fr;
    column-gap: clamp(20px, 2.5vw, 28px);
    align-items: stretch;
    padding: 18px 0 18px 18px;
  }

  /* Graph paper, barely there. */
  .grid {
    position: absolute;
    inset: 0;
    background-image:
      repeating-linear-gradient(to right, var(--rule-on-ink) 0 1px, transparent 1px 44px),
      repeating-linear-gradient(to bottom, var(--rule-on-ink) 0 1px, transparent 1px 44px);
    opacity: 0.45;
    pointer-events: none;
  }

  /* Routed at right angles, like a board trace. Decoration: it carries no
     state, so it never has to agree with which stage is current. */
  .traces {
    position: absolute;
    inset: -18px;
    width: calc(100% + 36px);
    height: calc(100% + 36px);
    pointer-events: none;
  }

  .trace polyline {
    fill: none;
    stroke: var(--rule-on-ink);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }

  .trace circle {
    fill: var(--rule-on-ink);
  }

  .trace-lit polyline {
    stroke: var(--accent);
    opacity: 0.55;
  }

  .trace-lit circle {
    fill: var(--accent);
    opacity: 0.55;
  }

  .rail {
    position: relative;
    background: var(--rule-on-ink);
  }

  /* Gold from the top down to the end of the current stage. Four stops, so it
     always ends on a row boundary rather than between two. */
  .rail-lit {
    position: absolute;
    inset-inline: 0;
    top: 0;
    height: 25%;
    background: var(--accent);
    transition: height 420ms cubic-bezier(0.22, 0.61, 0.36, 1);
  }

  /* Equal rows, so a quarter of the rail is exactly one step. */
  .steps {
    position: relative;
    display: grid;
    grid-auto-rows: 1fr;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .step {
    display: grid;
    grid-template-columns: 56px 1fr;
    grid-template-rows: auto auto;
    align-items: center;
    column-gap: clamp(14px, 1.8vw, 22px);
    padding-block: clamp(10px, 1.4vw, 16px);
  }

  /* Spanning both rows, so it centres against the number and name together
     rather than lining up with the number. */
  .icon {
    grid-row: 1 / 3;
    align-self: center;
  }

  /* ---- The icon: three states stacked, one visible at a time ---- */
  .icon {
    position: relative;
    display: grid;
    place-items: center;
    width: 56px;
    height: 68px;
  }

  .arch-fill,
  .arch-line {
    grid-area: 1 / 1;
    width: 34px;
    height: 46px;
    /* A semicircular top on a 34px-wide box, then square shoulders. */
    border-radius: 17px 17px 2px 2px;
    transition: opacity 320ms ease-out, background-color 320ms ease-out;
  }

  .arch-fill {
    background: var(--accent);
  }

  .arch-line {
    border: 2px solid var(--accent);
    opacity: 0;
  }

  /* Sonar rings, the same idiom as the homepage hero: an arc open at the
     bottom, so it reads as a wave rather than a ring. */
  .ring {
    grid-area: 1 / 1;
    border: 1px solid var(--accent);
    border-bottom: 0;
    border-radius: 999px 999px 0 0;
    opacity: 0;
    transition: opacity 320ms ease-out;
  }

  .ring-inner {
    width: 46px;
    height: 37px;
    align-self: end;
    margin-bottom: 11px;
  }

  .ring-outer {
    width: 60px;
    height: 48px;
    align-self: end;
    margin-bottom: 11px;
  }

  .step-number {
    font-variant-numeric: tabular-nums;
    font-weight: 600;
    font-size: 13px;
    letter-spacing: 0.18em;
    color: var(--muted-on-ink);
    transition: color 320ms ease-out;
  }

  .step-name {
    grid-column: 2;
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: clamp(1.375rem, 2.2vw, 1.75rem);
    letter-spacing: -0.02em;
    color: var(--muted-on-ink);
    transition: color 320ms ease-out;
  }

  /*
   * Resting state — no script, or a reader who asked for less motion: every
   * stage is a solid gold arch with its name in full paper. Nothing here needs
   * the animation to be legible; the states below only ever subtract.
   */
  .step-number,
  .step-name {
    color: var(--paper);
  }

  .step[data-state='upcoming'] .arch-fill {
    /* Mixed toward the ink rather than faded: opacity over navy desaturates
       the gold into a brown-grey. */
    background: #6E5C41;
    background: color-mix(in srgb, var(--accent) 42%, var(--ink));
  }

  .step[data-state='upcoming'] .ring { opacity: 0.4; }
  .step[data-state='upcoming'] .step-number,
  .step[data-state='upcoming'] .step-name { color: var(--muted-on-ink); }

  .step[data-state='done'] .arch-fill { opacity: 0; }
  .step[data-state='done'] .arch-line { opacity: 0.5; }
  .step[data-state='done'] .step-number,
  .step[data-state='done'] .step-name { color: var(--muted-on-ink); }

  .step[data-state='active'] .step-number { color: var(--accent); }
  .step[data-state='active'] .step-name { color: var(--paper); }

  /* The stage name and its one-line summary sit in a column of their own,
     under an oversized gold numeral; the body runs beside them. */
  .stage-inner {
    display: grid;
    gap: 28px;
  }

  @media (min-width: 900px) {
    .stage-inner {
      grid-template-columns: 300px 1fr;
      gap: 64px;
      align-items: start;
    }
  }

  /* Ink on the paper stages, gold on the ink ones. Gold on paper measures
     1.49:1 — below the 3:1 large text needs — and this numeral is the only
     place the stage's number appears, so it has to be readable. */
  .stage-numeral {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: clamp(3.5rem, 6.4vw, 5.5rem);
    line-height: 0.9;
    letter-spacing: -0.04em;
    color: var(--ink);
  }

  .surface-ink .stage-numeral {
    color: var(--accent);
  }

  .stage-mark h2 {
    margin-top: 12px;
    font-size: clamp(1.875rem, 3.6vw, 2.625rem);
    letter-spacing: -0.03em;
  }

  .stage-summary {
    margin-top: 14px;
    font-size: 17px;
    color: var(--surface-muted);
  }

  .stage-body {
    max-width: 68ch;
  }

  .stage-body > p {
    font-size: clamp(1.0625rem, 1.5vw, 1.25rem);
  }

  /* The category-naming sub-section sits inside Locate. A card with a gold
     edge, so it reads as an aside rather than a fifth stage. */
  .aside {
    margin-top: 36px;
    padding: 28px 30px 30px;
    border: 1px solid var(--surface-rule);
    border-left: 3px solid var(--accent);
    border-radius: 2px;
  }

  .surface-ink .aside {
    background: #12104A;
  }

  .aside h3 {
    font-size: clamp(1.25rem, 2vw, 1.5rem);
    letter-spacing: -0.01em;
  }

  .aside p {
    margin-top: 14px;
    font-size: 1.125rem;
  }

  /* Saturate's closing line, set as a statement rather than a sentence.
     Selected through .stage-body so it outranks the body-paragraph size. */
  .stage-body > .pull-quote {
    margin-top: 30px;
    padding-left: 18px;
    border-left: 3px solid var(--accent);
    font-family: var(--font-heading);
    font-weight: 500;
    font-size: clamp(1.25rem, 2.4vw, 1.625rem);
    line-height: 1.35;
    color: var(--surface-heading);
  }

  .faq-list {
    margin-top: 40px;
  }

  .faq-item + .faq-item {
    margin-top: 40px;
    padding-top: 40px;
    border-top: 1px solid var(--surface-rule);
  }

  .faq-item h3 {
    font-size: 1.25rem;
  }

  .faq-item p {
    margin-top: 12px;
  }
</style>
