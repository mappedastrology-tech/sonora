---
import Base from '../layouts/Base.astro';
import CTABlock from '../components/CTABlock.astro';
import Arch from '../components/Arch.astro';
import { STAGE_DETAIL } from '../lib/method-page';
import { FAQS } from '../lib/faq';
import { breadcrumbSchema, faqSchema } from '../lib/schema';

const path = '/method';

const schema = [
  breadcrumbSchema([
    { name: 'Home', path: '/' },
    { name: 'Method', path },
  ]),
  faqSchema(
    FAQS.map((faq) => ({ question: faq.question, answer: faq.answer })),
    path
  ),
];
---

<Base
  title="The Sonora Method — Answer Engine Optimization & Search Strategy"
  description="A four-stage framework for turning search into pipeline: Listen, Locate, Saturate, Sustain. Answer engine optimization, SEO, and positioning for companies that need leads."
  path={path}
  schema={schema}
>
  <section class="section page-hero">
    <div class="container">
      <div class="prose">
        <h1>The Sonora Method</h1>
        <p class="lead">
          Four stages for turning search into a source of leads. It covers
          answer engine optimization &mdash; getting named by ChatGPT,
          Perplexity, Gemini, Claude, and Google AI Overviews &mdash; alongside
          traditional search, positioning, and the third-party surfaces buyers
          check before they contact you.
        </p>
        <p>
          The distinction that matters: this is not a traffic strategy. Plenty of
          companies rank well for things nobody buys from. The work is being
          present on the questions people ask when they&rsquo;re about to spend
          money, and being convincing when they arrive.
        </p>
      </div>
    </div>
  </section>

  {
    STAGE_DETAIL.map((stage, index) => (
      <section
        class:list={['section stage', index % 2 === 0 ? 'surface-ink' : '']}
        aria-labelledby={`stage-${stage.number}`}
      >
        <div class="container">
          <div class="stage-inner" data-reveal>
            <div class="numeral">
              <Arch variant="outline" label={stage.number} size={96} />
            </div>
            <div class="prose">
              <h2 id={`stage-${stage.number}`}>
                {stage.number} &middot; {stage.name}
              </h2>
              {stage.paragraphs.map((paragraph) => (
                <p>{paragraph}</p>
              ))}

              {'aside' in stage && stage.aside && (
                <aside class="aside">
                  <h3>{stage.aside.heading}</h3>
                  {stage.aside.paragraphs.map((paragraph) => (
                    <p>{paragraph}</p>
                  ))}
                </aside>
              )}
            </div>
          </div>
        </div>
      </section>
    ))
  }

  <section class="section faq" aria-labelledby="faq-heading">
    <div class="container">
      <div class="prose" data-reveal>
        <h2 id="faq-heading">Common questions</h2>
        <div class="faq-list">
          {
            FAQS.map((faq) => (
              <div class="faq-item">
                <h3>{faq.question}</h3>
                <p>{faq.answer}</p>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <CTABlock />
</Base>

<style>
  .page-hero {
    padding-block: clamp(56px, 7vw, 96px) clamp(48px, 6vw, 72px);
  }

  .page-hero .lead {
    margin-top: 28px;
  }

  .stage-inner {
    display: grid;
    gap: 24px;
  }

  @media (min-width: 900px) {
    .stage-inner {
      grid-template-columns: 120px 1fr;
      gap: 56px;
    }
  }

  .numeral {
    line-height: 0;
  }

  /* The category-naming sub-section sits inside Locate, set apart by a gold
     rule so it reads as an aside rather than a fifth stage. */
  .aside {
    margin-top: 36px;
    padding: 4px 0 4px 24px;
    border-left: 2px solid var(--accent);
  }

  .aside h3 {
    font-size: 1.1875rem;
  }

  .aside p {
    margin-top: 12px;
  }

  .faq-list {
    margin-top: 40px;
  }

  .faq-item + .faq-item {
    margin-top: 40px;
    padding-top: 40px;
    border-top: 1px solid var(--surface-rule);
  }

  .faq-item h3 {
    font-size: 1.25rem;
  }

  .faq-item p {
    margin-top: 12px;
  }
</style>
