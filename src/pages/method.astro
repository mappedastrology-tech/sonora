---
import Base from '../layouts/Base.astro';
import CTABlock from '../components/CTABlock.astro';
import { STAGE_DETAIL } from '../lib/method-page';
import { FAQS } from '../lib/faq';
import { breadcrumbSchema, faqSchema } from '../lib/schema';

const path = '/method';

const schema = [
  breadcrumbSchema([
    { name: 'Home', path: '/' },
    { name: 'Method', path },
  ]),
  faqSchema(
    FAQS.map((faq) => ({ question: faq.question, answer: faq.answer })),
    path
  ),
];
---

<Base
  title="The Sonora Method — Positioning, Search and Content Strategy"
  description="Four stages for turning search into pipeline: Listen, Locate, Saturate, Sustain. Positioning, answer engine optimization and measurement for B2B companies."
  path={path}
  schema={schema}
>
  <section class="hero surface-ink">
    <div class="container hero-grid">
      <div>
        <h1>The Sonora Method</h1>
        <p class="hero-lead">
          Four stages for turning search into a source of leads.
        </p>
      </div>

      {/*
        The four stages as a vertical stack, with a gold marker stepping down
        the rail and lighting each one in turn. The rail sits outside the list
        rather than in it as a fifth item, so the steps number 1-4 for both the
        delays and a screen reader. Only the rail and the arches are hidden —
        the names are real content, legible whether or not the motion runs.
      */}
      <div class="stack">
        <span class="rail" aria-hidden="true"><span class="rail-marker"></span></span>
        <ol class="steps">
          {
            STAGE_DETAIL.map((stage) => (
              <li class="step">
                <span class="step-arch" aria-hidden="true"></span>
                <span class="step-number">{stage.number}</span>
                <span class="step-name">{stage.name}</span>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  {
    STAGE_DETAIL.map((stage, index) => (
      <section
        class:list={['section stage', index % 2 === 1 ? 'surface-ink' : '']}
        aria-labelledby={`stage-${stage.number}-heading`}
        id={`stage-${stage.number}`}
      >
        <div class="container">
          <div class="stage-inner">
            <div class="stage-mark" data-reveal>
              <p class="stage-numeral">{stage.number}</p>
              <h2 id={`stage-${stage.number}-heading`}>{stage.name}</h2>
              <p class="stage-summary">{stage.summary}</p>
            </div>

            <div class="stage-body prose" data-reveal>
              {stage.paragraphs.map((paragraph) => (
                <p>{paragraph}</p>
              ))}

              {'aside' in stage && stage.aside && (
                <aside class="aside">
                  <h3>{stage.aside.heading}</h3>
                  {stage.aside.paragraphs.map((paragraph) => (
                    <p>{paragraph}</p>
                  ))}
                </aside>
              )}

              {'pullQuote' in stage && stage.pullQuote && (
                <p class="pull-quote">{stage.pullQuote}</p>
              )}
            </div>
          </div>
        </div>
      </section>
    ))
  }

  <section class="section faq" aria-labelledby="faq-heading">
    <div class="container">
      <div class="prose" data-reveal>
        <h2 id="faq-heading">Common questions</h2>
        <div class="faq-list">
          {
            FAQS.map((faq) => (
              <div class="faq-item">
                <h3>{faq.question}</h3>
                <p>{faq.answer}</p>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <CTABlock />
</Base>

<style>
  .hero {
    padding-block: clamp(64px, 9vw, 112px) clamp(56px, 7vw, 96px);
  }

  .hero-grid {
    display: grid;
    gap: clamp(40px, 6vw, 72px);
    align-items: center;
  }

  @media (min-width: 900px) {
    .hero-grid {
      grid-template-columns: 1fr minmax(280px, 360px);
    }
  }

  .hero h1 {
    font-size: clamp(2.75rem, 6.4vw, 4.5rem);
    line-height: 1.02;
    letter-spacing: -0.04em;
    text-wrap: balance;
  }

  .hero-lead {
    margin-top: 24px;
    font-size: clamp(1.1875rem, 2vw, 1.375rem);
    line-height: 1.5;
    max-width: 34ch;
    color: var(--paper);
    opacity: 0.82;
  }

  /* ---- The stage stack ----
     A rail down the left with the four stages beside it. The rail spans every
     row, so the marker's 25% height is exactly one row, whatever the rows
     measure — which is why the rows are forced to equal height. */
  .stack {
    display: grid;
    grid-template-columns: 2px 1fr;
    column-gap: clamp(20px, 2.5vw, 28px);
    align-items: stretch;
  }

  .rail {
    position: relative;
    background: var(--rule-on-ink);
  }

  .rail-marker {
    position: absolute;
    inset-inline: 0;
    top: 0;
    height: 25%;
    background: var(--accent);
  }

  /* Equal rows, so a quarter of the rail is exactly one step. */
  .steps {
    display: grid;
    grid-auto-rows: 1fr;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .step {
    display: flex;
    align-items: center;
    gap: 14px;
    padding-block: clamp(14px, 1.8vw, 20px);
  }

  .step-arch {
    flex: none;
    width: 14px;
    height: 18px;
    border: 2px solid var(--accent);
    border-radius: 7px 7px 1px 1px;
  }

  .step-number {
    font-variant-numeric: tabular-nums;
    font-weight: 600;
    font-size: 15px;
    color: var(--accent);
  }

  .step-name {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: clamp(1.25rem, 2vw, 1.5rem);
    letter-spacing: -0.02em;
    color: var(--paper);
  }

  /* Without the animation every step reads as lit, which is the correct
     resting state: nothing here depends on the motion to be legible. The
     animation's job is only to dim the three steps that aren't current. */
  @media (prefers-reduced-motion: no-preference) {
    /* One 8s cycle, a stage every 2s, matching the homepage's sonar. */
    @keyframes step-cycle {
      0% { opacity: 0.34; }
      2% { opacity: 1; }
      22% { opacity: 1; }
      25% { opacity: 0.34; }
      100% { opacity: 0.34; }
    }

    @keyframes step-arch-cycle {
      0% { background: transparent; }
      2% { background: var(--accent); }
      22% { background: var(--accent); }
      25% { background: transparent; }
      100% { background: transparent; }
    }

    @keyframes rail-step {
      from { transform: translateY(0); }
      to { transform: translateY(300%); }
    }

    /* `backwards` holds the 0% frame through the delay. Without it a step
       waiting its turn renders in its normal state — fully lit — so all four
       would sit bright and light up one at a time over the first cycle. */
    .step {
      animation: step-cycle 8s linear infinite backwards;
    }

    .step-arch {
      animation: step-arch-cycle 8s linear infinite backwards;
    }

    .step:nth-child(2),
    .step:nth-child(2) .step-arch { animation-delay: 2s; }
    .step:nth-child(3),
    .step:nth-child(3) .step-arch { animation-delay: 4s; }
    .step:nth-child(4),
    .step:nth-child(4) .step-arch { animation-delay: 6s; }

    /* Four discrete stops rather than a glide, so the marker lands on a row
       instead of sliding between two. */
    .rail-marker {
      animation: rail-step 8s steps(4, jump-none) infinite;
    }
  }

  /* The stage name and its one-line summary sit in a column of their own,
     under an oversized gold numeral; the body runs beside them. */
  .stage-inner {
    display: grid;
    gap: 28px;
  }

  @media (min-width: 900px) {
    .stage-inner {
      grid-template-columns: 300px 1fr;
      gap: 64px;
      align-items: start;
    }
  }

  .stage-numeral {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: clamp(3.5rem, 6.4vw, 5.5rem);
    line-height: 0.9;
    letter-spacing: -0.04em;
    color: var(--accent);
  }

  .stage-mark h2 {
    margin-top: 12px;
    font-size: clamp(1.875rem, 3.6vw, 2.625rem);
    letter-spacing: -0.03em;
  }

  .stage-summary {
    margin-top: 14px;
    font-size: 17px;
    color: var(--surface-muted);
  }

  .stage-body {
    max-width: 68ch;
  }

  .stage-body > p {
    font-size: clamp(1.0625rem, 1.5vw, 1.25rem);
  }

  /* The category-naming sub-section sits inside Locate. A card with a gold
     edge, so it reads as an aside rather than a fifth stage. */
  .aside {
    margin-top: 36px;
    padding: 28px 30px 30px;
    border: 1px solid var(--surface-rule);
    border-left: 3px solid var(--accent);
    border-radius: 2px;
  }

  .surface-ink .aside {
    background: #12104A;
  }

  .aside h3 {
    font-size: clamp(1.25rem, 2vw, 1.5rem);
    letter-spacing: -0.01em;
  }

  .aside p {
    margin-top: 14px;
    font-size: 1.125rem;
  }

  /* Saturate's closing line, set as a statement rather than a sentence.
     Selected through .stage-body so it outranks the body-paragraph size. */
  .stage-body > .pull-quote {
    margin-top: 30px;
    padding-left: 18px;
    border-left: 3px solid var(--accent);
    font-family: var(--font-heading);
    font-weight: 500;
    font-size: clamp(1.25rem, 2.4vw, 1.625rem);
    line-height: 1.35;
    color: var(--surface-heading);
  }

  .faq-list {
    margin-top: 40px;
  }

  .faq-item + .faq-item {
    margin-top: 40px;
    padding-top: 40px;
    border-top: 1px solid var(--surface-rule);
  }

  .faq-item h3 {
    font-size: 1.25rem;
  }

  .faq-item p {
    margin-top: 12px;
  }
</style>
