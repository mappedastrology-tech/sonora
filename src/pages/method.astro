---
import Base from '../layouts/Base.astro';
import CTABlock from '../components/CTABlock.astro';
import Arch from '../components/Arch.astro';
import { ORDER, STAGE_DETAIL } from '../lib/method-page';
import { FAQS } from '../lib/faq';
import { breadcrumbSchema, faqSchema } from '../lib/schema';

const path = '/method';

const schema = [
  breadcrumbSchema([
    { name: 'Home', path: '/' },
    { name: 'Method', path },
  ]),
  faqSchema(
    FAQS.map((faq) => ({ question: faq.question, answer: faq.answer })),
    path
  ),
];
---

<Base
  title="The Sonora Method — Positioning, Search and Content Strategy"
  description="Four stages for turning search into pipeline: Listen, Locate, Saturate, Sustain. Positioning, answer engine optimization and measurement for B2B companies."
  path={path}
  schema={schema}
>
  <section class="hero surface-ink">
    <div class="container">
      <p class="eyebrow-gold">The Sonora Method</p>
      <h1>Four stages for turning search into a source of leads.</h1>

      <nav class="jump" aria-label="The four stages">
        {
          STAGE_DETAIL.map((stage) => (
            <a href={`#stage-${stage.number}`}>
              <span class="jump-arch" aria-hidden="true"></span>
              <span class="jump-number">{stage.number}</span>
              {stage.name}
            </a>
          ))
        }
      </nav>
    </div>
  </section>

  <!-- The argument for the sequence, before the stages themselves. It stays on
       ink like the hero above it, so a rule rather than a colour change marks
       the join. -->
  <section class="section order surface-ink" aria-labelledby="order-heading">
    <div class="container">
      <div class="prose" data-reveal>
        <p class="eyebrow-gold">{ORDER.eyebrow}</p>
        <h2 id="order-heading">{ORDER.heading}</h2>
        {ORDER.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    </div>
  </section>

  {
    STAGE_DETAIL.map((stage, index) => (
      <section
        class:list={['section stage', index % 2 === 1 ? 'surface-ink' : '']}
        aria-labelledby={`stage-${stage.number}-heading`}
        id={`stage-${stage.number}`}
      >
        <div class="container">
          <div class="stage-inner" data-reveal>
            <div class="numeral">
              <Arch variant="outline" label={stage.number} size={96} />
            </div>
            <div class="prose">
              <h2 id={`stage-${stage.number}-heading`}>
                {stage.number} &middot; {stage.name}
              </h2>
              {stage.paragraphs.map((paragraph) => (
                <p>{paragraph}</p>
              ))}

              {'aside' in stage && stage.aside && (
                <aside class="aside">
                  <h3>{stage.aside.heading}</h3>
                  {stage.aside.paragraphs.map((paragraph) => (
                    <p>{paragraph}</p>
                  ))}
                </aside>
              )}
            </div>
          </div>
        </div>
      </section>
    ))
  }

  <section class="section faq" aria-labelledby="faq-heading">
    <div class="container">
      <div class="prose" data-reveal>
        <h2 id="faq-heading">Common questions</h2>
        <div class="faq-list">
          {
            FAQS.map((faq) => (
              <div class="faq-item">
                <h3>{faq.question}</h3>
                <p>{faq.answer}</p>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <CTABlock />
</Base>

<style>
  .hero {
    padding-block: clamp(64px, 9vw, 112px) clamp(56px, 7vw, 96px);
  }

  .hero h1 {
    margin-top: 20px;
    font-size: clamp(2.5rem, 6vw, 4.125rem);
    line-height: 1.02;
    letter-spacing: -0.04em;
    max-width: 18ch;
    text-wrap: balance;
  }

  /* Jump links to the four stages. The little arch is the brand mark reduced
     to an outline, drawn with a border rather than shipped as an image. */
  .jump {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: clamp(32px, 4vw, 44px);
  }

  .jump a {
    display: flex;
    align-items: center;
    gap: 12px;
    border: 1px solid var(--rule-on-ink);
    border-radius: 2px;
    padding: 12px 20px 12px 14px;
    font-weight: 600;
    font-size: 16px;
    color: var(--paper);
    transition: border-color 160ms ease-out, transform 160ms ease-out;
  }

  .jump a:hover,
  .jump a:focus-visible {
    border-color: var(--accent);
    transform: translateY(-2px);
  }

  .jump-arch {
    width: 16px;
    height: 20px;
    border: 2px solid var(--accent);
    border-radius: 8px 8px 1px 1px;
  }

  .jump-number {
    font-variant-numeric: tabular-nums;
  }

  /* The hero is ink and so is this, so the boundary needs drawing. */
  .order {
    border-top: 1px solid var(--rule-on-ink);
    padding-block: clamp(56px, 7vw, 96px);
  }

  .order h2 {
    margin-top: 14px;
  }

  .stage-inner {
    display: grid;
    gap: 24px;
  }

  @media (min-width: 900px) {
    .stage-inner {
      grid-template-columns: 120px 1fr;
      gap: 56px;
    }
  }

  .numeral {
    line-height: 0;
  }

  /* The category-naming sub-section sits inside Locate, set apart by a gold
     rule so it reads as an aside rather than a fifth stage. */
  .aside {
    margin-top: 36px;
    padding: 4px 0 4px 24px;
    border-left: 2px solid var(--accent);
  }

  .aside h3 {
    font-size: 1.1875rem;
  }

  .aside p {
    margin-top: 12px;
  }

  .faq-list {
    margin-top: 40px;
  }

  .faq-item + .faq-item {
    margin-top: 40px;
    padding-top: 40px;
    border-top: 1px solid var(--surface-rule);
  }

  .faq-item h3 {
    font-size: 1.25rem;
  }

  .faq-item p {
    margin-top: 12px;
  }
</style>
