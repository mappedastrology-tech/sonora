---
/**
 * The page shell. Every page renders through this.
 */
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Seo from '../components/Seo.astro';
import { GA_MEASUREMENT_ID } from '../lib/site';

interface Props {
  title: string;
  description: string;
  path: string;
  image?: string;
  ogType?: 'website' | 'article';
  schema?: object[];
  noindex?: boolean;
  /** /book has no footer CTA block; it is the destination. */
  bodyClass?: string;
}

const { title, description, path, image, ogType, schema, noindex, bodyClass } =
  Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Marks the document as JS-capable before first paint. Everything that
         would otherwise hide content without JavaScript is scoped to html.js. -->
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>

    <!-- Tab icons are transparent, so the ink mark needs a paper counterpart
         for dark browser chrome. Browsers that ignore `media` here keep the
         ink version, which is the same result as not shipping the pair. -->
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href="/favicon-32.png"
      media="(prefers-color-scheme: light)"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="16x16"
      href="/favicon-16.png"
      media="(prefers-color-scheme: light)"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href="/favicon-32-dark.png"
      media="(prefers-color-scheme: dark)"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="16x16"
      href="/favicon-16-dark.png"
      media="(prefers-color-scheme: dark)"
    />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#0C0A3E" />

    <!-- Google Fonts. Both subsets ship with unicode-range, so browsers fetch
         the latin block only. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Poppins:wght@600&display=swap"
    />

    <link
      rel="alternate"
      type="application/rss+xml"
      title="Sonora — Writing"
      href="/rss.xml"
    />

    <Seo
      title={title}
      description={description}
      path={path}
      image={image}
      ogType={ogType}
      schema={schema}
      noindex={noindex}
    />

    <!-- Google tag (gtag.js). Loads async, after the document, so it costs
         nothing on first paint. Note that GA4 sets first-party cookies — the
         privacy page says so. -->
    <script
      is:inline
      async
      src={`https://www.googletagmanager.com/gtag/js?id=${GA_MEASUREMENT_ID}`}
    ></script>
    <script is:inline define:vars={{ GA_MEASUREMENT_ID }}>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag('js', new Date());
      gtag('config', GA_MEASUREMENT_ID);
    </script>
  </head>

  <body class={bodyClass}>
    <a href="#main" class="skip-link">Skip to content</a>
    <Nav />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <script>
      /*
       * One scroll observer for the whole site.
       *
       * Two jobs, both armed once and never replayed:
       *
       *   [data-reveal]  fade-and-rise, fired at ~90% of the viewport, with an
       *                  80ms stagger between siblings.
       *   [data-animate] a block whose own CSS keys off [data-armed], fired at
       *                  ~35% visibility. Used by the charts and the Why now
       *                  scenes.
       *
       * Anything already scrolled past when the page loads snaps straight to
       * its final state rather than animating in behind the reader. Under
       * prefers-reduced-motion everything resolves immediately. A 12s failsafe
       * arms whatever is left, so a missed observer can never leave content
       * hidden.
       */
      const reveals = Array.from(document.querySelectorAll<HTMLElement>('[data-reveal]'));
      const blocks = Array.from(document.querySelectorAll<HTMLElement>('[data-animate]'));
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      const showReveal = (el: HTMLElement, animate: boolean) => {
        if (el.dataset.shown) return;
        el.dataset.shown = '1';

        if (animate) {
          const siblings = Array.from(
            el.parentElement?.querySelectorAll<HTMLElement>(':scope > [data-reveal]') ?? []
          );
          const index = Math.min(Math.max(siblings.indexOf(el), 0), 4);
          el.style.transitionDelay = `${index * 80}ms`;
        } else {
          el.style.transition = 'none';
        }

        el.classList.add('is-visible');
      };

      const armBlock = (el: HTMLElement, animate: boolean) => {
        if (el.dataset.armed) return;
        if (!animate) el.dataset.instant = '1';
        el.dataset.armed = '1';
      };

      if (reduced || !('IntersectionObserver' in window)) {
        reveals.forEach((el) => showReveal(el, false));
        blocks.forEach((el) => armBlock(el, false));
      } else {
        // Anything above the fold on load is already "past" — snap it.
        const snapPast = (el: HTMLElement, arm: (e: HTMLElement, a: boolean) => void) => {
          if (el.getBoundingClientRect().bottom <= 0) arm(el, false);
        };
        reveals.forEach((el) => snapPast(el, showReveal));
        blocks.forEach((el) => snapPast(el, armBlock));

        const revealObserver = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              showReveal(entry.target as HTMLElement, true);
              revealObserver.unobserve(entry.target);
            });
          },
          { rootMargin: '0px 0px -10% 0px', threshold: 0.01 }
        );

        /*
         * intersectionRatio is a fraction of the *element*, so a block taller
         * than the viewport can never reach 0.35 — the Why now scenes are
         * exactly that on a phone. Measure against whichever is smaller, the
         * element or the viewport, and take the fine-grained thresholds only
         * as a cue to re-measure.
         */
        const visibleFraction = (el: HTMLElement) => {
          const rect = el.getBoundingClientRect();
          if (!rect.height) return 0;
          const viewport = window.innerHeight;
          const visible = Math.min(rect.bottom, viewport) - Math.max(rect.top, 0);
          return Math.max(visible, 0) / Math.min(rect.height, viewport);
        };

        const blockObserver = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              const el = entry.target as HTMLElement;
              if (!entry.isIntersecting || visibleFraction(el) < 0.35) return;
              armBlock(el, true);
              blockObserver.unobserve(el);
            });
          },
          { threshold: [0, 0.05, 0.1, 0.15, 0.2, 0.25, 0.3, 0.35] }
        );

        reveals.forEach((el) => revealObserver.observe(el));
        blocks.forEach((el) => blockObserver.observe(el));

        // Failsafe: nothing stays hidden because an observer never fired.
        window.setTimeout(() => {
          reveals.forEach((el) => showReveal(el, false));
          blocks.forEach((el) => armBlock(el, false));
        }, 12000);
      }
    </script>
  </body>
</html>
