---
/**
 * A post's mark: the brand arch, no container.
 *
 * Drawn as a box with a semicircular top rather than masked from the arch
 * artwork, because that is the only way to get an outlined version — and the
 * outline is what distinguishes two of the four topics now that there is no
 * tile behind it to carry a colour.
 */
interface Props {
  topic: string;
  size?: number;
}

const { topic, size = 26 } = Astro.props;

/* The brand arch is 710 x 1110. */
const height = Math.round(size / 0.64);
---

<span
  class="arch"
  data-topic={topic}
  style={`--arch-w:${size}px; --arch-h:${height}px; --arch-r:${size / 2}px`}
  aria-hidden="true"></span>

<style>
  .arch {
    display: block;
    flex: none;
    width: var(--arch-w);
    height: var(--arch-h);
    border-radius: var(--arch-r) var(--arch-r) 1px 1px;
  }

  /* Filled, then outlined, in each of the two brand colours: four topics,
     four marks, no fifth colour and no box. */
  .arch[data-topic='Search'] {
    background: var(--accent);
  }

  .arch[data-topic='Positioning'] {
    background: var(--ink);
  }

  .arch[data-topic='AI answers'] {
    border: 2px solid var(--accent);
  }

  .arch[data-topic='Measurement'] {
    border: 2px solid var(--ink);
  }
</style>
