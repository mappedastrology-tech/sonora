---
/**
 * A post in a list. `detailed` adds reading time — used on /blog, omitted in
 * the homepage's three-up row.
 */
import { formatDate } from '../lib/format';

interface Props {
  /** Heading level for the card title. Set it so the page never skips a level. */
  level?: 2 | 3;
  title: string;
  description: string;
  date: Date;
  href: string;
  readingTime?: number;
  detailed?: boolean;
}

const { level = 3, title, description, date, href, readingTime, detailed = false } =
  Astro.props;

const Heading = `h${level}` as 'h2' | 'h3';

/* Excerpts are trimmed to the spec's word counts: 20 on the homepage, 25 in
   the blog index. */
const words = description.split(/\s+/);
const limit = detailed ? 25 : 20;
const excerpt =
  words.length > limit ? `${words.slice(0, limit).join(' ')}…` : description;
---

<li class="post-card">
  <article>
    <p class="meta">
      <time datetime={date.toISOString()}>{formatDate(date)}</time>
      {detailed && readingTime && <span> &middot; {readingTime} min read</span>}
    </p>
    <Heading class="card-title"><a href={href}>{title}</a></Heading>
    <p class="excerpt">{excerpt}</p>
  </article>
</li>

<style>
  .post-card {
    padding-top: 24px;
    border-top: 1px solid var(--surface-rule);
  }

  .post-card .card-title {
    margin-top: 10px;
    max-width: 28ch;
    font-family: var(--font-heading);
    font-size: 1.375rem;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.01em;
  }

  .post-card .card-title a {
    text-decoration: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: 2px;
    text-underline-offset: 5px;
    transition: text-decoration-color 120ms ease-out;
  }

  .post-card .card-title a:hover {
    text-decoration-color: var(--accent);
  }

  .excerpt {
    margin-top: 12px;
    font-size: 1.0625rem;
    line-height: 1.6;
    max-width: 44ch;
  }
</style>
