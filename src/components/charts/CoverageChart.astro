---
/**
 * AI Overview coverage by vertical.
 *
 * Built from HTML and CSS rather than SVG on purpose. Horizontal bars are just
 * boxes with a width, and keeping the labels as real text means they stay at a
 * real font size — an SVG scaled down to a 327px phone column renders its
 * labels at about nine pixels, which fails the "legible at 375px" requirement.
 *
 * As a side effect the data is already readable text in the served HTML, so
 * there is nothing here a model has to infer from a path.
 */
const BARS = [
  { label: 'Healthcare', value: 88 },
  { label: 'Education', value: 83 },
  { label: 'B2B Technology', value: 82 },
];
---

<figure class="chart">
  <p class="chart-title">Share of searches returning an AI Overview, by vertical</p>

  <ul>
    {
      BARS.map((bar) => (
        <li>
          <p class="label">
            <span>{bar.label}</span>
            <span class="value">{bar.value}%</span>
          </p>
          <div class="track">
            <div class="bar" style={`width:${bar.value}%`}></div>
          </div>
        </li>
      ))
    }
  </ul>

  <figcaption class="meta">BrightEdge, February 2025 &ndash; February 2026.</figcaption>
</figure>

<style>
  .chart {
    margin: 0;
    max-width: 640px;
  }

  /* The heading above the section already frames this, so the chart's own title
     is available to screen readers without shouting on the page. */
  .chart-title {
    font-size: 0.9375rem;
    line-height: 1.5;
    color: var(--surface-muted);
    margin-bottom: 28px;
  }

  ul {
    display: grid;
    gap: 26px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .label {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    font-size: 1.0625rem;
    font-weight: 500;
    color: var(--surface-heading);
    margin-bottom: 10px;
  }

  .value {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 1.125rem;
    font-variant-numeric: tabular-nums;
  }

  /* A faint full-width track makes the remaining share readable without a
     second colour or an axis. */
  .track {
    height: 22px;
    border-radius: 4px;
    background: var(--surface-rule);
    overflow: hidden;
  }

  .bar {
    height: 100%;
    border-radius: 4px;
    background: var(--accent);
  }

  figcaption {
    margin-top: 32px;
  }
</style>
