---
/**
 * Zero-click search rate over time.
 *
 * Inline SVG with no JavaScript, so the whole chart is in the served HTML —
 * required by the build spec, and the reason the data also appears as a real
 * table below. A model can read a table; it cannot read a path.
 *
 * Every point is directly labelled rather than revealed on hover. With four
 * points that reads better than a tooltip and costs no script.
 */
const POINTS = [
  { year: 2019, value: 49 },
  { year: 2020, value: 64.8 },
  { year: 2024, value: 58.5 },
  { year: 2026, value: 68 },
];

const W = 640;
const H = 320;
const PAD = { top: 46, right: 34, bottom: 54, left: 62 };
const MAX = 80;

const plotW = W - PAD.left - PAD.right;
const plotH = H - PAD.top - PAD.bottom;

/* Years are spaced evenly rather than to scale: the gaps between surveys are
   uneven and the caption already warns the deltas are not precise. */
const x = (index: number) => PAD.left + (index / (POINTS.length - 1)) * plotW;
const y = (value: number) => PAD.top + plotH - (value / MAX) * plotH;

const line = POINTS.map((p, i) => `${i === 0 ? 'M' : 'L'}${x(i)} ${y(p.value)}`).join(' ');
const gridValues = [0, 20, 40, 60, 80];
---

<figure class="chart">
  <svg
    viewBox={`0 0 ${W} ${H}`}
    role="img"
    aria-labelledby="zeroclick-title zeroclick-desc"
    preserveAspectRatio="xMidYMid meet"
  >
    <title id="zeroclick-title">
      Share of US Google searches ending without a click, 2019 to 2026
    </title>
    <desc id="zeroclick-desc">
      A line rising from 49 percent in 2019 to 68 percent in 2026, dipping to
      58.5 percent in 2024.
    </desc>

    {
      gridValues.map((value) => (
        <line x1={PAD.left} x2={W - PAD.right} y1={y(value)} y2={y(value)} class="grid" />
      ))
    }
    {
      gridValues.map((value) => (
        <text x={PAD.left - 14} y={y(value) + 8} class="axis" text-anchor="end">
          {value}%
        </text>
      ))
    }

    <path d={line} class="series" />

    {
      POINTS.map((point, index) => (
        <circle cx={x(index)} cy={y(point.value)} r="6" class="dot" />
      ))
    }
    {
      POINTS.map((point, index) => (
        <text
          x={x(index)}
          y={y(point.value) - 20}
          class="value"
          text-anchor={index === 0 ? 'start' : index === POINTS.length - 1 ? 'end' : 'middle'}
        >
          {point.value}%
        </text>
      ))
    }
    {
      POINTS.map((point, index) => (
        <text x={x(index)} y={H - 12} class="axis" text-anchor="middle">
          {point.year}
        </text>
      ))
    }
  </svg>

  <!-- The data as a real table: an accessibility requirement, and an AEO one.
       A model can read a table; it cannot read a path.

       The wrapper carries the hiding, not the table. Auto table layout treats
       `width: 1px` as a minimum and expands to fit its content, so hiding the
       table directly left a 460px element sticking out of the page. -->
  <div class="visually-hidden">
  <table>
    <caption>Share of US Google searches ending without a click</caption>
    <thead>
      <tr><th scope="col">Year</th><th scope="col">Zero-click share</th></tr>
    </thead>
    <tbody>
      {
        POINTS.map((point) => (
          <tr>
            <th scope="row">{point.year}</th>
            <td>{point.value}%</td>
          </tr>
        ))
      }
    </tbody>
  </table>
  </div>

  <figcaption class="meta">
    SparkToro, June 2026. Panels differ across years &mdash; treat the trend as
    directional, not the deltas as precise.
  </figcaption>
</figure>

<style>
  .chart {
    margin: 0;
    max-width: 640px;
  }

  .chart svg {
    width: 100%;
    height: auto;
    overflow: visible;
  }

  /* Grid and axes stay recessive; the series carries the eye. */
  .grid {
    stroke: var(--surface-rule);
    stroke-width: 1;
  }

  /* Sizes are viewBox units, so they shrink with the chart. At 375px the
     column is about 327px wide — a 0.51 scale — so 16px would render at
     roughly 8px. These are set to clear 11px there. */
  .axis {
    font-family: var(--font-body);
    font-size: 23px;
    fill: var(--surface-muted);
  }

  .series {
    fill: none;
    stroke: var(--accent);
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .dot {
    fill: var(--accent);
    /* A ring in the surface colour keeps the marker legible on the line. */
    stroke: var(--surface);
    stroke-width: 2;
  }

  .value {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 26px;
    fill: var(--surface-heading);
  }

  figcaption {
    margin-top: 20px;
    max-width: 52ch;
  }
</style>
