---
/**
 * The four stages in a 2x2 grid. Homepage only — /method renders each stage
 * as a full section instead.
 */
import Arch from './Arch.astro';
import { STAGES } from '../lib/method';
---

<ol class="stages">
  {
    STAGES.map((stage) => (
      <li class="stage" data-reveal>
        <Arch variant="outline" label={stage.number} size={54} />
        <h3>{stage.name}</h3>
        <p>{stage.short}</p>
      </li>
    ))
  }
</ol>

<style>
  .stages {
    display: grid;
    gap: clamp(40px, 5vw, 64px);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  @media (min-width: 768px) {
    .stages {
      grid-template-columns: repeat(2, 1fr);
      gap: clamp(48px, 5vw, 72px) clamp(40px, 5vw, 80px);
    }
  }

  .stage h3 {
    margin-top: 20px;
  }

  .stage p {
    margin-top: 12px;
    max-width: 46ch;
  }
</style>
