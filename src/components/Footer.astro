---
/**
 * Site footer. Three link columns beside the descriptor — no newsletter here;
 * the design moves the signup onto the homepage.
 */
import { EMAIL, DESCRIPTOR, SITE_NAME } from '../lib/site';

const year = 2026;
---

<footer class="site-footer surface-ink">
  <div class="container footer-inner">
    <p class="descriptor">{SITE_NAME} &mdash; {DESCRIPTOR.charAt(0).toLowerCase() + DESCRIPTOR.slice(1)}</p>

    <nav class="footer-nav" aria-label="Footer">
      <ul>
        <li><a href="/method">Method</a></li>
        <li><a href="/services">Services</a></li>
        <li><a href="/why-now">Why now</a></li>
      </ul>
      <ul>
        <li><a href="/about">About</a></li>
        <li><a href="/blog">Blog</a></li>
        <li><a href="/contact">Contact</a></li>
        <li><a href="/privacy">Privacy</a></li>
      </ul>
      <ul>
        <li><a href={`mailto:${EMAIL}`}>{EMAIL}</a></li>
      </ul>
    </nav>
  </div>

  <div class="container bottom">
    <p class="meta">&copy; {year} {SITE_NAME}</p>
  </div>
</footer>

<style>
  .site-footer {
    padding-block: 56px 28px;
  }

  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-start;
    gap: 40px 48px;
    font-size: 16px;
  }

  .descriptor {
    color: var(--muted-on-ink);
    max-width: 30ch;
  }

  .footer-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 24px 48px;
  }

  .footer-nav ul {
    display: flex;
    flex-direction: column;
    gap: 10px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .footer-nav a {
    color: var(--paper);
    border-bottom: 1px solid transparent;
    transition: border-color 140ms ease-out;
  }

  .footer-nav a:hover {
    border-bottom-color: var(--accent);
  }

  .bottom {
    margin-top: 48px;
    padding-top: 20px;
    border-top: 1px solid var(--rule-on-ink);
  }
</style>
