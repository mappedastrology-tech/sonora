---
/**
 * Closing call to action. Appears at the foot of every page except /book.
 */
---

<section class="cta surface-ink" data-reveal>
  <div class="container">
    <div class="cta-inner">
      <h2>Start with what&rsquo;s actually true.</h2>
      <p class="lead">
        Thirty minutes. Tell me what&rsquo;s not working and I&rsquo;ll tell you whether
        I can fix it.
      </p>
      <p class="btn-wrap"><a href="/book" class="btn">Book a call</a></p>
    </div>
  </div>
</section>

<style>
  .cta {
    padding-block: clamp(72px, 9vw, 120px);
    /* Several pages end on an inverted section. Without this the CTA merges
       into it and reads as one very long ink block. */
    border-top: 1px solid var(--surface-rule);
  }

  .cta-inner {
    max-width: 44ch;
  }

  .lead {
    margin-top: 20px;
  }

  .btn-wrap {
    margin-top: 40px;
  }
</style>
