---
/**
 * Site header. Sits on ink on every page, 72px tall.
 *
 * The wordmark is a CSS mask rather than an <img> so it can be tinted paper
 * from the one asset, which is what the design calls for. That makes it a
 * background rather than an image, hence the explicit role and label.
 *
 * Menu behaviour is progressive: without JavaScript the links render as a
 * wrapped row under the logo, so every destination stays reachable. The `js`
 * class on <html> (set by an inline script in Base.astro) switches on the
 * hamburger and the full-screen overlay.
 */
import { NAV_LINKS } from '../lib/site';

const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) =>
  pathname === href || pathname.startsWith(`${href}/`);
---

<header class="site-header" data-nav>
  <div class="container header-inner">
    <a href="/" class="logo" aria-label="Sonora — home">
      <span class="wordmark" role="img" aria-label="Sonora"></span>
    </a>

    <button
      class="menu-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="site-menu"
      data-menu-toggle
    >
      <span class="visually-hidden">Menu</span>
      <span class="bars" aria-hidden="true"></span>
    </button>

    <nav id="site-menu" class="site-nav" aria-label="Primary">
      <ul class="nav-list">
        {
          NAV_LINKS.map((link) => (
            <li>
              <a
                href={link.href}
                class:list={['nav-link', { current: isCurrent(link.href) }]}
                aria-current={isCurrent(link.href) ? 'page' : undefined}
              >
                {link.label}
              </a>
            </li>
          ))
        }
        <li class="nav-cta">
          <a
            href="/book"
            class="btn-gold"
            aria-current={isCurrent('/book') ? 'page' : undefined}
          >
            Book a call
          </a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: relative;
    z-index: 100;
    background: var(--ink);
    color: var(--paper);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    min-height: var(--nav-height);
    flex-wrap: wrap;
  }

  .logo {
    display: block;
    line-height: 0;
    flex-shrink: 0;
    position: relative;
    z-index: 2;
  }

  .wordmark {
    display: block;
    width: 132px;
    height: 24px;
    background-color: var(--paper);
    -webkit-mask: url('/brand/sonora-wordmark.webp') no-repeat left center / contain;
    mask: url('/brand/sonora-wordmark.webp') no-repeat left center / contain;
  }

  @media (max-width: 639px) {
    .wordmark {
      width: 108px;
      height: 20px;
    }
  }

  .menu-toggle {
    display: none;
    position: relative;
    z-index: 2;
    background: none;
    border: 0;
    padding: 12px;
    margin-right: -12px;
    cursor: pointer;
  }

  .bars,
  .bars::before,
  .bars::after {
    display: block;
    width: 22px;
    height: 2px;
    background: var(--paper);
    transition: transform 200ms ease-out, opacity 150ms ease-out;
  }

  .bars::before,
  .bars::after {
    content: '';
    position: relative;
  }

  .bars::before { top: -7px; }
  .bars::after { top: 5px; }

  .nav-list {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 4px 34px;
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 16px;
    font-weight: 500;
  }

  .nav-link {
    display: inline-flex;
    align-items: center;
    min-height: 24px;
    padding: 6px 0;
    color: var(--paper);
    border-bottom: 2px solid transparent;
    transition: border-color 140ms ease-out;
  }

  .nav-link:hover,
  .nav-link.current {
    border-bottom-color: var(--accent);
  }

  .btn-gold {
    display: inline-block;
    background: var(--accent);
    color: var(--ink);
    padding: 13px 24px;
    border-radius: 2px;
    font-weight: 600;
    font-size: 15px;
    transition: transform 140ms ease-out, box-shadow 140ms ease-out;
  }

  .btn-gold:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 22px rgba(243, 198, 119, 0.28);
  }

  /* Without JS the links stay in the flow and simply wrap. */
  @media (max-width: 900px) {
    .site-nav {
      width: 100%;
      padding-bottom: 16px;
    }

    .nav-list {
      gap: 4px 20px;
    }
  }

  :global(html.js) .menu-toggle {
    display: none;
  }

  @media (max-width: 900px) {
    :global(html.js) .menu-toggle {
      display: block;
    }

    :global(html.js) .site-nav {
      position: fixed;
      inset: 0;
      z-index: 1;
      width: 100%;
      padding: calc(var(--nav-height) + 40px) var(--gutter) 40px;
      background: var(--ink);
      overflow-y: auto;
      visibility: hidden;
      opacity: 0;
      transition: opacity 200ms ease-out, visibility 200ms ease-out;
    }

    :global(html.js) .site-header[data-open] .site-nav {
      visibility: visible;
      opacity: 1;
    }

    :global(html.js) .site-header[data-open] .bars {
      transform: rotate(45deg);
    }

    :global(html.js) .site-header[data-open] .bars::before {
      opacity: 0;
    }

    :global(html.js) .site-header[data-open] .bars::after {
      top: -2px;
      transform: rotate(-90deg);
    }

    :global(html.js) .nav-list {
      flex-direction: column;
      align-items: flex-start;
      gap: 28px;
    }

    :global(html.js) .nav-link {
      font-family: var(--font-heading);
      font-weight: 600;
      font-size: 1.375rem;
      line-height: 1.3;
    }

    :global(html.js) .btn-gold {
      font-size: 1.0625rem;
      padding: 15px 26px;
    }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('[data-nav]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');

  if (header && toggle) {
    const setOpen = (open: boolean) => {
      header.toggleAttribute('data-open', open);
      toggle.setAttribute('aria-expanded', String(open));
      document.body.style.overflow = open ? 'hidden' : '';
    };

    toggle.addEventListener('click', () => {
      setOpen(!header.hasAttribute('data-open'));
    });

    header.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => setOpen(false));
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && header.hasAttribute('data-open')) {
        setOpen(false);
        toggle.focus();
      }
    });

    window.matchMedia('(min-width: 901px)').addEventListener('change', (event) => {
      if (event.matches) setOpen(false);
    });
  }
</script>
