---
/**
 * Foot-of-post author block. Small headshot, two lines, link to /about.
 */
import { AUTHOR } from '../lib/site';
---

<aside class="author" aria-label="About the author">
  <img
    src="/images/taylor-corbett.webp"
    alt={`${AUTHOR.name}, founder of Sonora`}
    width="72"
    height="72"
    loading="lazy"
    decoding="async"
  />
  <div>
    <p class="name">{AUTHOR.name}</p>
    <p class="bio">
      Content and search strategy for startups and B2B software companies.
      Fifteen years of working out what people are looking for.
      <a href="/about" class="textlink">More about Taylor</a>.
    </p>
  </div>
</aside>

<style>
  .author {
    display: flex;
    gap: 20px;
    align-items: flex-start;
    padding-top: 32px;
    border-top: 1px solid var(--rule);
  }

  .author img {
    width: 72px;
    height: 72px;
    border-radius: 36px 36px 2px 2px;
    object-fit: cover;
    flex-shrink: 0;
  }

  .name {
    font-family: var(--font-heading);
    font-weight: 600;
    color: var(--ink);
  }

  .bio {
    margin-top: 6px;
    font-size: 1rem;
    line-height: 1.6;
    max-width: 52ch;
  }
</style>
